{
  "name": "joule-project-api",
  "version": "0.22.0",
  "description": "CAP backend for the Procurement Copilot. Hosts LLM-backed actions (summarize, explain, extract) plus a @rag-annotated SupplierContracts entity that Joule can query semantically — all via auto-declared OData actions, no glue code.",
  "private": true,
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@sap/cds": "^9",
    "@saptarishi/cds-plugin-llm": "^1.62.0",
    "@saptarishi/cds-plugin-vector-hana": "^0.12.0",
    "express": "^4"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.5.0"
  },
  "engines": {
    "node": ">=18"
  },
  "cds": {
    "requires": {
      "llm": {
        "[development]": {
          "kind": "llm-groq",
          "modelId": "llama-3.3-70b-versatile"
        },
        "[ollama]": {
          "kind": "llm-ollama",
          "modelId": "qwen2.5:14b"
        },
        "[hybrid]": {
          "kind": "llm-anthropic",
          "modelId": "claude-opus-4-7"
        },
        "[production]": {
          "kind": "llm-groq",
          "modelId": "llama-3.3-70b-versatile"
        },
        "[genai-hub]": {
          "kind": "llm-genai-hub",
          "credentials": {
            "deploymentId": "<AICORE_DEPLOYMENT_ID>",
            "resourceGroup": "default"
          }
        }
      },
      "llm-embed": {
        "[development]": {
          "kind": "llm-ollama",
          "modelId": "nomic-embed-text"
        },
        "[ollama]": {
          "kind": "llm-ollama",
          "modelId": "nomic-embed-text"
        },
        "[genai-hub]": {
          "kind": "llm-genai-hub",
          "credentials": {
            "embeddingDeploymentId": "<AICORE_EMBED_DEPLOYMENT_ID>",
            "resourceGroup": "default"
          }
        }
      },
      "auth": {
        "[development]": {
          "kind": "dummy"
        },
        "[production]": {
          "kind": "dummy"
        }
      },
      "db": {
        "[development]": {
          "kind": "sqlite",
          "credentials": {
            "url": ":memory:"
          }
        },
        "[production]": {
          "kind": "sqlite",
          "credentials": {
            "url": ":memory:"
          }
        }
      }
    }
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4.0"
  },
  "overrides": {
    "@cap-js/sqlite": {
      "better-sqlite3": "$better-sqlite3"
    }
  }
}
