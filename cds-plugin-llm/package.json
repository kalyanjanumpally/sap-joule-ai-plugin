{
  "name": "@saptarishi/cds-plugin-llm",
  "version": "1.50.0",
  "description": "LLM-agnostic AI service for SAP CAP. Speaks Anthropic, Google Gemini, AWS Bedrock, Azure OpenAI, Ollama, Groq, Fireworks, DeepSeek, Mistral, any OpenAI-compatible endpoint, and SAP Generative AI Hub behind one API. Supports vision / multimodal input, streaming responses, structured outputs, tool use / function calling, and automatic retries with exponential backoff.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalyanjanumpally/sap-joule-ai-plugin.git",
    "directory": "cds-plugin-llm"
  },
  "bugs": {
    "url": "https://github.com/kalyanjanumpally/sap-joule-ai-plugin/issues"
  },
  "homepage": "https://github.com/kalyanjanumpally/sap-joule-ai-plugin/tree/main/cds-plugin-llm#readme",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "saptarishi-llm": "bin/saptarishi-llm.js"
  },
  "files": [
    "bin/",
    "cds-plugin.js",
    "lib/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.js",
    "typecheck": "tsc --noEmit",
    "example:procurement": "node examples/procurement-handler.js"
  },
  "keywords": [
    "sap",
    "cap",
    "cds",
    "llm",
    "ai",
    "anthropic",
    "claude",
    "gemini",
    "bedrock",
    "aws-bedrock",
    "fireworks",
    "deepseek",
    "mistral",
    "ollama",
    "groq",
    "openai-compatible",
    "generative-ai-hub",
    "vision",
    "multimodal",
    "streaming",
    "joule"
  ],
  "author": "",
  "license": "Apache-2.0",
  "cds": {
    "requires": {
      "kinds": {
        "llm-anthropic": {
          "impl": "@saptarishi/cds-plugin-llm/lib/providers/anthropic.js",
          "external": true
        },
        "llm-ollama": {
          "impl": "@saptarishi/cds-plugin-llm/lib/providers/ollama.js",
          "external": true
        },
        "llm-genai-hub": {
          "impl": "@saptarishi/cds-plugin-llm/lib/providers/genai-hub.js",
          "external": true
        },
        "llm-groq": {
          "impl": "@saptarishi/cds-plugin-llm/lib/providers/groq.js",
          "external": true
        },
        "llm-openai-compatible": {
          "impl": "@saptarishi/cds-plugin-llm/lib/providers/openai-compatible.js",
          "external": true
        },
        "llm-azure-openai": {
          "impl": "@saptarishi/cds-plugin-llm/lib/providers/azure-openai.js",
          "external": true
        },
        "llm-gemini": {
          "impl": "@saptarishi/cds-plugin-llm/lib/providers/gemini.js",
          "external": true
        },
        "llm-bedrock": {
          "impl": "@saptarishi/cds-plugin-llm/lib/providers/bedrock.js",
          "external": true
        },
        "llm-fireworks": {
          "impl": "@saptarishi/cds-plugin-llm/lib/providers/fireworks.js",
          "external": true
        },
        "llm-deepseek": {
          "impl": "@saptarishi/cds-plugin-llm/lib/providers/deepseek.js",
          "external": true
        },
        "llm-mistral": {
          "impl": "@saptarishi/cds-plugin-llm/lib/providers/mistral.js",
          "external": true
        }
      }
    }
  },
  "peerDependencies": {
    "@sap/cds": ">=7",
    "@aws-sdk/client-bedrock-runtime": ">=3.600.0"
  },
  "peerDependenciesMeta": {
    "@sap/cds": {
      "optional": false
    },
    "@aws-sdk/client-bedrock-runtime": {
      "optional": true
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@sap/cds": "^9.9.2",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
